#!/usr/bin/env false
#shellcheck shell=bash disable=1090,1091

. lib/base
. lib/vars

# Add a project by its name
va() {

if ! [ -d p ]; then
    echo "Execute this from the source directory" >&2
    return 2
fi

project="${1:-${project:?Specify the project to add}}"
project_bak="$project"
if [[ $project != */* ]] && ! [ -f p/$project/config ]; then
    project="$(find p -type d -name $1 | sed s,^p/,,)"

    case "$(printf "$project" | wc -l)" in
        1)
            read -rn1 -p "A project of a similar name exists. Target it? (yes/no/die) "
            echo
            case ${REPLY,,} in
                y*) : ;;
                d*) return 0 ;;
                n*) project="${project_bak}" ;;
                *) echo "Invalid action: $REPLY" >&2 && return 2 ;;
            esac
        ;;
        *) project="${project_bak}" ;;
    esac
fi
unset project_bak
export project

mkdir -p "p/${project:?}"
if ! [ -f "p/$project/config" ]; then
install -vDm644 /dev/stdin "p/$project/config" << .
upstream=""

:commit  () { :; }
:release () { :; }
.
fi

"${EDITOR:?Please set \$EDITOR}" "p/$project/config"

}

# Add a CPAN-tracked Perl module by its name
vacpan() {

if ! [ -d p ]; then
    echo "Execute this from the source directory" >&2
    return 2
fi

local pretty="${1//::/-}"
project="perl/${pretty,,}"
export project="${project/::/-/g}"

mkdir -p "p/${project:?}"
if ! [ -f "p/$project/config" ]; then
install -vDm644 /dev/stdin "p/$project/config" << .
upstream="cpan:$pretty"

:release () { :; }
.
fi

vt "$project"

}

# Test a project by its name
vt() {

if ! [ -d p ]; then
    echo "Execute this from the source directory" >&2
    return 2
fi

project="${1:-${project:?Specify the project to test}}"
if [[ $project != */* ]] && ! [ -f p/$project/config ]; then
    project="$(find p -type d -name $1 | sed s,^p/,,)"
    case "$(printf "$project" | wc -l)" in
        0) echo "No such project" >&2 && return 2 ;;
        1) : ;;
        *) echo "Multiple projects with this name exist:" >&2 && echo "$project" >&2 && return 2 ;;
    esac
fi
export project

install -D config "$VAT_TARGET/config.bak"
cat >> config << '.'

# AUTO-GENERATED by `vt` from `/lib/dev`
GUARANTEE=true
DRY=true
.

./vat "$project"
cp -f "$VAT_TARGET/config.bak" config

cat "$VAT_TARGET/logs/$project/out"

if [ -s "$VAT_TARGET/logs/$project/err" ]; then
    cat "$VAT_TARGET/logs/$project/err" >&2
    return 1
fi

}

# Execute a command from VAT's environment
vx() {

echo "${project:?}" >/dev/null # ensure it's set

export name="${project##*/}"
. "p/$project/config"
. lib/vars
. lib/config

upstream="$(echo "${upstream:?}" | sed -f "${VAT_TARGET:?}/shortforms.sed")"
"$@"

}
