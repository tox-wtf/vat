#!/usr/bin/env false
#shellcheck shell=bash

. lib/base
. lib/vars

# Add a project by its name
va() {

if ! [ -d p ]; then
    echo "Execute this from the source directory" >&2
    return 2
fi

export project="$1"
mkdir -p "p/${project:?}"
if ! [ -f "p/$project/config" ]; then
install -vDm644 /dev/stdin "p/$project/config" << .
upstream=""

:release() { :; }

:commit() { :; }
.
fi

"${EDITOR:?Please set \$EDITOR}" "p/$project/config"

}

# Test a project by its name
vt() {

if ! [ -d p ]; then
    echo "Execute this from the source directory" >&2
    return 2
fi

export project="${1:-${project:?Specify the project to test}}"

cp -f config "$VAT_TARGET/config.bak"
cat >> config << '.'

# AUTO-GENERATED by `vt` from `/lib/dev`
GUARANTEE=true
DRY=true
.

./vat "$project"
cp -f "$VAT_TARGET/config.bak" config

cat "$VAT_TARGET/logs/$project/out"

if [ -s "$VAT_TARGET/logs/$project/err" ]; then
    cat "$VAT_TARGET/logs/$project/err" >&2
    return 1
fi

}

# Execute a command from VAT's environment
vx() {

echo "${project:?}" >/dev/null # ensure it's set

name="${project##*/}"
. p/"$project"/config
. lib/vars
. lib/config

upstream="$(echo "${upstream:?}" | sed -f "${VAT_TARGET:?}/shortforms.sed")"
eval "$@"

}
