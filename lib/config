#!/usr/bin/env false
# shellcheck shell=bash disable=1087,1090,2119,2120,2154
#
# Small library to read the config

set -u

# Read config
declare -A shortforms
. config || {
    log "Invalid config"
    exit 2
}

install -Dm644 /dev/null "$VAT_TARGET/shortforms.sed"
for shortform in "${!shortforms[@]}"; do
    from="$shortform:"
    to="${shortforms[$shortform]}"
    echo "s|$from|$to|" >> "$VAT_TARGET/shortforms.sed"
    echo "s|$to|$from|" >> "$VAT_TARGET/longforms.sed"
done
