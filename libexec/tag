#!/usr/bin/env bash

# Generate a tag and release assets for the run, once it's completed

command -v git &>/dev/null || {
    echo 'Missing `git` -- cannot continue'
    exit 1
}

. lib/vars

projects=$(git status --porcelain=v1 -u all p/**/v.tsv | sed -e 's,^p/,,' -e 's,/v.tsv$,,')

shopt -s globstar
shopt -s nullglob

set -u

rm -rf "$VAT_CACHE/dist"
mkdir -pv "$VAT_CACHE/dist"
cp -vf "$VAT_CACHE/report" "$VAT_CACHE/dist/report"
cp -vf "$VAT_CACHE/logs/ALL."* "$VAT_CACHE/dist/"
xz -9e "$VAT_CACHE/dist/ALL."*

runcount="$(<runcount)"
version="$(<version)"

(
    echo "Archiving logs"
    cd "$VAT_CACHE"
    tar --numeric-owner --transform "s,logs,logs-$version-$runcount," -cJvf "$VAT_CACHE/dist/logs.tar.xz" "logs"
    echo "Archiving projects"
    cd "$VAT_ROOT"
    tar --numeric-owner --transform "s,p,p-$version-$runcount,"       -cJvf "$VAT_CACHE/dist/p.tar.xz"    "p"
)

for project in "${projects[@]}"; do
    echo git tag "run-$runcount" -m "$(<$VAT_CACHE/report)"
    echo git push
    echo git push --tags
    echo gh release create "VAT $version run #$runcount" --notes-from-tag --latest=false "$VAT_CACHE/dist/"*
done
