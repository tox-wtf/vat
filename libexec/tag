#!/usr/bin/env bash
# shellcheck disable=1091,2164

# Generate a tag and release assets for the run, once it's completed

for cmd in gh git; do
    command -v "$cmd" &>/dev/null || { echo "Missing $cmd -- cannot continue" >&2 && exit 1; }
done

. lib/vars

shopt -s globstar
set -u

rm -rf "$VAT_TARGET/dist"
mkdir -p "$VAT_TARGET/dist"
cp -f "$VAT_TARGET/report" "$VAT_TARGET/dist/report"
cp -f "$VAT_TARGET/logs/ALL."* "$VAT_TARGET/dist/"
xz -9e "$VAT_TARGET/dist/ALL."*

runcount="$(<runcount)"
version="$(<version)"

(
    echo "Archiving logs"
    cd "$VAT_TARGET"
    tar --numeric-owner --transform "s,logs,logs-$version-$runcount," -cJf "$VAT_TARGET/dist/logs.tar.xz" "logs"
    echo "Archiving projects"
    cd "$VAT_ROOT"
    tar --numeric-owner --transform "s,p,p-$version-$runcount,"       -cJf "$VAT_TARGET/dist/p.tar.xz"    "p"
)

git tag "runs/$version/$runcount" -m "$(<"$VAT_TARGET/report")"
git push
git push --tags
gh release create "runs/$version/$runcount" --title "VAT $version run #$runcount" --notes-from-tag --latest=false "$VAT_TARGET/dist/"*
