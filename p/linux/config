upstream="https://www.kernel.org/feeds/kdist.xml"
# Channel names are based on the kdist atom feed

:mainline() {
    expected='[0-9]\.[0-9]+(-rc[0-9]+)?'

    fetch() {
        cr | grep -Eo '<title>[0-9](\.[0-9])+(-rc[0-9]+)?: mainline</title>' |
            vtrim -e 's,^<title>,,;s,: mainline</title>$,,'
    }
}

# Corresponds to latest release
:stable() {
    expected='[0-9]\.[0-9]+\.[0-9]+'

    fetch() {
        cr | grep -Eo '<title>[0-9](\.[0-9])+: stable</title>' | vrepo
    }
}

# Corresponds to latest LTS
:longterm() {
    expected='[0-9]\.[0-9]+\.[0-9]+'

    fetch() {
        cr | grep -Eo '<title>[0-9\.]+: longterm</title>' | vrepo | vsort
    }
}

:next() {
    expected='[0-9]{8}'

    fetch() {
        cr | grep -Eo '<title>next-[0-9]{8}:' | vrepo -1
    }
}

:commit() {
    upstream="kernel:linux/kernel/git/torvalds/linux.git"
}
