upstream="https://www.kernel.org/feeds/kdist.xml"
# Channel names are based on the kdist atom feed

:mainline() {
    expected='[0-9]\.[0-9]+(-rc[0-9]+)?'

    fetch() {
        cr | xmlstarlet sel -t -v '/rss/channel/item[1]/title' |
            vtrim -e "s,: mainline,,"
    }
}

# Corresponds to latest release
:stable() {
    expected='[0-9]\.[0-9]+\.[0-9]+'

    fetch() {
        cr | xmlstarlet sel -t -v '/rss/channel/item[2]/title' |
            vtrim -e "s,: stable,,"
    }
}

:longterm() {
    expected='[0-9]\.[0-9]+\.[0-9]+'

    fetch() {
        cr | xmlstarlet sel -t -v '/rss/channel/item/title' | grep longterm |
            head -n1 | cut -d: -f1
    }
}

:next() {
    expected='[0-9]{8}'

    fetch() {
        cr | xmlstarlet sel -t -v '/rss/channel/item[9]/title' |
            vtrim -e 's,next-,,' -e 's,: linux-next,,'
    }
}

:commit() {
    upstream="kernel:linux/kernel/git/torvalds/linux.git"
}
