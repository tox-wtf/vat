upstream="gh:GNOME/glib-networking"

:release() {
    fetch() {
        gr | vtrim -e 's,^glib-,,' | vfs | grep -v '\.9[0-9]$' | vsort
    }
}

:unstable() {
    expected="[0-9]+(\.[0-9]+)*(-|.)?(rc|alpha|beta|a|b|pre|dev)?\.?[0-9]*"
    fetch() {
        gr | vtrim -e 's,^glib-,,' | vsort
    }
}

:commit() { :; }
