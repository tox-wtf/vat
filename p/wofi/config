chance=55

:commit  () {
    upstream="https://hg.sr.ht/~scoopta/wofi/rev/default"
    fetch() {
        cr | commitgrep -o
    }
}
:release () {
    upstream="https://hg.sr.ht/~scoopta/wofi/tags"
    fetch() {
        # FIXME: Filter out the source of 5.3.1 instead
        cr | vrepo -3 | grep -vF 5.3.1 | vsort
    }
}
