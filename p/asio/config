upstream="gh:chriskohlhoff/asio"

:commit  () { :; }

# TODO: 1.36.0 appears to be the latest stable version, but 1.38.0 also exists
:release () {
    upstream="https://think-async.com/Asio/"
    fetch() {
         cr | grep -o '^<p>Asio version [0-9]\+\.[0-9]\+\.[0-9]\+' | cut -d\  -f3
    }
}

:unstable() {
    fetch() {
        gr | vtrim -e 's,-,.,g' | vsort
    }
}
