upstream="gh:openjdk/jdk"
compare=false

:unstable() {
    fetch() {
        gr | vtrim -e 's,\+,.,' -e 's,-?b-?,.,' | vsort
    }
}

:release() {
    expected='[0-9]{2}\.u[0-9]+'

    fetch() {
        gr | vtrim -e 's,\+,.,' -e 's,-?b-?,.,' | grep "^$(date +%y)\." | grep -v ga | vsort | rev | sed 's,\.,u.,' | rev
    }
}

:21() {
    upstream+="21u"
    expected='21\.[0-9]+\.[0-9]+\.u[0-9]+'

    fetch() {
        gr | vtrim -e 's,\+,.,' -e 's,-?b-?,.,' | grep "^21\." | grep -v ga | vrep -3 | vsort | rev | sed 's,\.,u.,' | rev
    }
}

