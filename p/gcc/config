upstream="https://gcc.gnu.org/git/gcc.git"

:release() {
    fetch() {
        gr | vtrim | grep -Ev '(basepoints|misc|prereleases|vendors)/' | vtrim -e 's,releases/,,' -e 's,gcc-,,' | fsl | vsort
    }
}

:unstable() {
    expected='[0-9]+'

    fetch() {
        gr | vtrim -re 's,(basepoints|releases)/,,' -e 's,gcc-,,' | fsl | vsort
    }
}

:commit() { :; }
