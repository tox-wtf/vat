upstream="gh:proftpd/proftpd"
_expected='[0-9]+(\.[0-9]+)*[a-z]?'

:commit  () { :; }

:release () {
    expected="$_expected"
    fetch() {
        gr | vfs | vtrim | vsort -c
    }
}

:unstable() {
    expected='('"$_expected"'|[0-9]+(\.[0-9]+)*-?(rc|alpha|beta|a|b|pre|dev)?\.?[0-9]*)'
    fetch() {
        gr | vtrim | grep -v '[a-z][0-9]-[0-9]$' | vsort -c
    }
}
